# SentinelDesk environment template. Copy to .env in the repo root and fill in the blanks:
#   cp infra/env.template .env
# Never commit .env. Hriday shares the real keys privately.

# ---- LLM providers: OpenAI first, Gemini as the fallback ------------------
# Generation tries OpenAI, then Gemini if OpenAI fails or has no key.
# Embeddings use ONE provider (OpenAI if its key is set, else Gemini) and never switch per call:
# vectors from different models can't share an index. Changing provider means re-embedding the KB.
OPENAI_API_KEY=
OPENAI_GEN_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEN_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
# auto | openai | gemini  (auto = OpenAI first, then Gemini)
LLM_PROVIDER=auto
EMBED_PROVIDER=auto

# ---- Redis vector DB (local copy: infra/docker-compose.dev.yml) ----------
REDIS_PASSWORD=change-me-locally
REDIS_URL=redis://:change-me-locally@localhost:6379/0
REDIS_CHUNK_INDEX=idx:chunks
REDIS_CHUNK_PREFIX=chunk:
REDIS_QUEUE_PREFIX=queue:
# Set to false while running the evaluation, so it never changes the index
UPDATE_QUERIED_COUNT=true

# ---- Cloudflare R2 (raw data, splits, embeddings, models, snapshots) -----
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentineldesk-artifacts
ARTIFACT_VERSION=v1

# ---- Python engine --------------------------------------------------------
POLICY_PATH=engine/config/policy.yaml

# ---- Production (EC2 only) ------------------------------------------------
# Public API hostname served by Caddy with automatic HTTPS (DNS A record -> EC2 Elastic IP)
API_DOMAIN=
# REDIS_PASSWORD is generated on the box by infra/deploy.sh if missing

# ---- Go gateway -----------------------------------------------------------
PORT=8080
ENGINE_URL=http://localhost:8000
MOCK_ENGINE=true

# ---- Optional tuning ------------------------------------------------------
# The Gemini API rejects deadlines under 10 s
LLM_TIMEOUT_S=10
GEMINI_CONCURRENCY=8
# false = skip the R2 model download at engine start (local development)
SYNC_ARTIFACTS=true
