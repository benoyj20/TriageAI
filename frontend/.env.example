# Copy to .env.local (never commit .env files).
# true  = run fully in the browser against the built-in mock engine (no gateway needed)
# false = call the Go gateway through the Vite proxy (/api -> :8080)
VITE_USE_MOCK=true
# Leave empty to use the Vite proxy. Set to a full URL for a deployed gateway.
VITE_API_BASE=
