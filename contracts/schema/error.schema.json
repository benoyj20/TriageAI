{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_JSON",
            "VALIDATION_ERROR",
            "PAYLOAD_TOO_LARGE",
            "RATE_LIMITED",
            "ENGINE_UNAVAILABLE",
            "ENGINE_TIMEOUT",
            "ENGINE_BAD_RESPONSE",
            "INTERNAL",
            "NOT_FOUND",
            "METHOD_NOT_ALLOWED"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
